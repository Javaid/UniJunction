# -----------------------------------------------------------------------
# Academic Connect — Environment Configuration Template
#
# Copy the relevant section into client/.env and server/.env.
# Never commit a real .env file with actual credentials.
# -----------------------------------------------------------------------

# ---- Frontend (client/.env) --------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# ---- Backend (server/.env) ---------------------------------------------
NODE_ENV=development
PORT=5000

# Database (MySQL 8.x via Sequelize + mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=academic_connect
DB_USER=root
DB_PASSWORD=
DB_ENCRYPT=false

# Connection pool (optional — sensible defaults apply if omitted)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Authentication — access tokens are short-lived, stateless JWTs; refresh
# tokens are opaque, DB-backed, and revocable (no secret of their own).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing cost (bcrypt). Higher = slower/more secure; 12 is a
# reasonable default in 2026.
BCRYPT_SALT_ROUNDS=12

# Email verification
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Rate limiting for auth endpoints (register/login/refresh/resend-verification)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# CORS — the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173
